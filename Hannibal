<!DOCTYPE html>
<html lang="en">
<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <title>Junior Explorer Homeschool Academy</title>
 <style>
 :root {
 --bright-orange: #ff6600;
 --dino-green: #39ff14;
 --sky-blue: #00ccff;
 --mud-brown: #1e1e24;
 --card-bg: #2a2a35;
 }
 body {
 background-color: var(--mud-brown);
 color: #ffffff;
 font-family: 'Comic Sans MS', 'Chalkboard SE', sans-serif;
 margin: 0;
 padding: 15px;
 display: flex;
 flex-direction: column;
 align-items: center;
 min-height: 100vh;
 user-select: none;
 }
 header {
 width: 95%;
 max-width: 1000px;
 display: flex;
 justify-content: space-between;
 align-items: center;
 background: #111116;
 border: 4px solid var(--bright-orange);
 border-radius: 15px;
 padding: 10px 20px;
 margin-bottom: 15px;
 box-shadow: 0 5px 15px rgba(0,0,0,0.5);
 }
 .title-text {
 font-size: 1.5rem;
 color: var(--sky-blue);
 font-weight: bold;
 }
 .star-tracker {
 font-size: 1.5rem;
 color: #ffd700;
 }
 #main-stage {
 width: 95%;
 max-width: 1000px;
 background: #16161f;
 border: 4px solid #ffffff;
 border-radius: 20px;
 height: 520px;
 position: relative;
 overflow: hidden;
 display: flex;
 flex-direction: column;
 }
 #menu-screen {
 display: grid;
 grid-template-columns: repeat(3, 1fr);
 gap: 20px;
 padding: 30px;
 height: 100%;
 box-sizing: border-box;
 }
 .menu-card {
 background: var(--card-bg);
 border: 4px solid #444;
 border-radius: 20px;
 display: flex;
 flex-direction: column;
 justify-content: center;
 align-items: center;
 cursor: pointer;
 transition: transform 0.2s, border-color 0.2s;
 }
 .menu-card:hover {
 transform: scale(1.05);
 }
 .menu-card.truck-theme { border-color: var(--bright-orange); }
 .menu-card.dino-theme { border-color: var(--dino-green); }
 .menu-card.con-theme { border-color: var(--sky-blue); }
 .card-icon { font-size: 5rem; margin-bottom: 10px; }
 .card-label { font-size: 1.4rem; font-weight: bold; text-align: center; }
 .game-view {
 display: none;
 flex-direction: column;
 height: 100%;
 padding: 20px;
 box-sizing: border-box;
 }
 .view-panel {
 height: 220px;
 background: #000;
 border-radius: 15px;
 display: flex;
 justify-content: center;
 align-items: center;
 font-size: 6rem;
 position: relative;
 margin-bottom: 20px;
 border: 2px solid #333;
 }
 .asl-bubble {
 position: absolute;
 top: 10px;
 right: 10px;
 background: rgba(255,255,255,0.9);
 padding: 10px;
 border-radius: 10px;
 font-size: 2.5rem;
 border: 3px solid var(--dino-green);
 }
 .action-grid {
 display: grid;
 grid-template-columns: repeat(4, 1fr);
 gap: 15px;
 flex-grow: 1;
 }
 .big-touch-btn {
 background: #252535;
 border: 4px solid #ffffff;
 border-radius: 15px;
 color: #fff;
 font-size: 1.8rem;
 font-weight: bold;
 font-family: inherit;
 cursor: pointer;
 display: flex;
 flex-direction: column;
 justify-content: center;
 align-items: center;
 box-shadow: 0 6px 0 #111;
 transition: transform 0.1s;
 }
 .big-touch-btn:active {
 transform: translateY(4px);
 box-shadow: 0 2px 0 #111;
 }
 .big-touch-btn .sub-symbol {
 font-size: 2.5rem;
 margin-bottom: 5px;
 }
 #home-btn {
 position: absolute;
 bottom: 15px;
 left: 15px;
 background: #ff3333;
 border: 3px solid #fff;
 border-radius: 50%;
 width: 60px;
 height: 60px;
 font-size: 2rem;
 cursor: pointer;
 display: none;
 justify-content: center;
 align-items: center;
 z-index: 100;
 }
 </style>
</head>
<body>
<header>
 <div class="title-text">■ HANNIBAL'S PLAYROOM</div>
 <div class="star-tracker" id="star-count">■ 0 STARS</div>
</header>
<div id="main-stage">
 <button id="home-btn" onclick="returnToMenu()">■</button>
 <div id="menu-screen">
 <div class="menu-card truck-theme" onclick="startLevel('trucks')">
 <div class="card-icon">■</div>
 <div class="card-label">MONSTER TRUCK<br>SOUNDS</div>
 </div>
 <div class="menu-card dino-theme" onclick="startLevel('dinos')">
 <div class="card-icon">■</div>
 <div class="card-label">DINOSAUR<br>SIGN LANGUAGE</div>
 </div>
 <div class="menu-card con-theme" onclick="startLevel('construction')">
 <div class="card-icon">■■</div>
 <div class="card-label">CONSTRUCTION<br>COUNTING</div>
 </div>
 </div>
 <div id="level-trucks" class="game-view">
 <div class="view-panel" id="truck-viewport">■</div>
 <div class="action-grid">
 <button class="big-touch-btn" style="border-color:var(--bright-orange);" onclick="playPhonics('Ah',  <div class="sub-symbol">■■ Ah</div>
 <span>A</span>
 </button>
 <button class="big-touch-btn" style="border-color:var(--bright-orange);" onclick="playPhonics('Oh',  <div class="sub-symbol">■■ Oh</div>
 <span>O</span>
 </button>
 <button class="big-touch-btn" style="border-color:var(--bright-orange);" onclick="playPhonics('Eee' <div class="sub-symbol">■■ Eee</div>
 <span>E</span>
 </button>
 <button class="big-touch-btn" style="border-color:var(--bright-orange);" onclick="playPhonics('Broom <div class="sub-symbol">■ Vroom</div>
 <span>TRUCK</span>
 </button>
 </div>
 </div>
 <div id="level-dinos" class="game-view">
 <div class="view-panel" id="dino-viewport">
 <span id="dino-character">■</span>
 <div class="asl-bubble" id="asl-cue">■■</div>
 </div>
 <div class="action-grid" id="dino-choices"></div>
 </div>
 <div id="level-construction" class="game-view">
 <div class="view-panel" id="construction-viewport" style="font-size:4rem; gap:10px;"></div>
 <div class="action-grid" id="construction-choices"></div>
 </div>
</div>
<script>
 let starScore = 0;
 let activeLevel = "";
 let currentDinoTarget = {};
 let currentCountTarget = 0;
 const dinoQuestions = [
 { word: "More", icon: "■", asl: "■■", voice: "More dinosaur! Give me more!" },
 { word: "Eat", icon: "■", asl: "■■", voice: "Eat! The dinosaur is hungry. Eat!" },
 { word: "Stop", icon: "■", asl: "■■", voice: "Stop! Dinosaur says stop." },
 { word: "Help", icon: "■", asl: "■■", voice: "Help! Help the tiny dinosaur." }
 ];
 function speakText(text) {
 if ('speechSynthesis' in window) {
 window.speechSynthesis.cancel();
 const utterance = new SpeechSynthesisUtterance(text);
 utterance.rate = 0.85;
 utterance.pitch = 1.1;
 window.speechSynthesis.speak(utterance);
 }
 }
 function addStar() {
 starScore++;
 document.getElementById('star-count').innerText = `■ ${starScore} STARS`;
 speakText("Awesome! You got a star!");
 }
 function startLevel(type) {
 document.getElementById('menu-screen').style.display = 'none';
 document.getElementById('home-btn').style.display = 'flex';
 activeLevel = `level-${type}`;
 document.getElementById(activeLevel).style.display = 'flex';
 if (type === 'trucks') {
 speakText("Monster truck rally! Press a big button to make the truck bounce!");
 } else if (type === 'dinos') {
 setupDinoQuestion();
 } else if (type === 'construction') {
 setupConstructionQuestion();
 }
 }
 function returnToMenu() {
 if(activeLevel) {
 document.getElementById(activeLevel).style.display = 'none';
 }
 document.getElementById('home-btn').style.display = 'none';
 document.getElementById('menu-screen').style.display = 'grid';
 window.speechSynthesis.cancel();
 }
 function playPhonics(sound, completeExpression) {
 speakText(sound);
 const vp = document.getElementById('truck-viewport');
 vp.style.transform = "translateY(-30px) scale(1.1)";
 setTimeout(() => {
 vp.style.transform = "none";
 speakText(completeExpression);
 }, 300);
 }
 function setupDinoQuestion() {
 const randomTarget = dinoQuestions[Math.floor(Math.random() * dinoQuestions.length)];
 currentDinoTarget = randomTarget;
 document.getElementById('asl-cue').innerText = randomTarget.asl;
 document.getElementById('dino-character').innerText = "■";
 speakText(`Show me the sign for: ${randomTarget.word}.`);
 const grid = document.getElementById('dino-choices');
 grid.innerHTML = "";
 dinoQuestions.forEach(item => {
 const btn = document.createElement('button');
 btn.classList.add('big-touch-btn');
 btn.style.borderColor = "var(--dino-green)";
 btn.innerHTML = `<div class="sub-symbol">\${item.icon}</div><span>\${item.word.toUpperCase()}</span>
 btn.onclick = () => {
 if (item.word === currentDinoTarget.word) {
 document.getElementById('dino-character').innerText = "■■";
 say(currentDinoTarget.voice);
 addStar();
 setTimeout(setupDinoQuestion, 2000);
 } else {
 speakText(`Try again! Look for \${currentDinoTarget.word}`);
 }
 };
 grid.appendChild(btn);
 });
 }
 function setupConstructionQuestion() {
 currentCountTarget = Math.floor(Math.random() * 4) + 1;
 const viewport = document.getElementById('construction-viewport');
 viewport.innerHTML = "";

 for(let i=0; i < currentCountTarget; i++) {
 const itemObj = document.createElement('span');
 itemObj.innerText = "■";
 itemObj.style.cursor = "pointer";
 itemObj.onclick = (e) => {
 e.stopPropagation();
 speakText(`\${i + 1}`);
 };
 viewport.appendChild(itemObj);
 }
 speakText(`Count the construction trucks! How many do you see?`);
 const choicesGrid = document.getElementById('construction-choices');
 choicesGrid.innerHTML = "";
 for(let num=1; num <= 4; num++) {
 const btn = document.createElement('button');
 btn.classList.add('big-touch-btn');
 btn.style.borderColor = "var(--sky-blue)";
 btn.innerHTML = `<div class="sub-symbol">■■</div><span>\${num}</span>`;

 btn.onclick = () => {
 if(num === currentCountTarget) {
 viewport.innerHTML = "■■■";
 speakText(`Great job! That is exactly \${currentCountTarget} trucks!`);
 addStar();
 setTimeout(setupConstructionQuestion, 2500);
 } else {
 speakText(`Let's count them together. Tap each truck!`);
 }
 };
 choicesGrid.appendChild(btn);
 }
 }
</script>
</body>
</html>
